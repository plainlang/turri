exports[`the bubblewrap arguments, per role > are generated from the coding agent's fence 1`] = `
[
  "--die-with-parent",
  "--unshare-pid",
  "--unshare-ipc",
  "--unshare-uts",
  "--unshare-cgroup-try",
  "--ro-bind-try",
  "/usr",
  "/usr",
  "--ro-bind-try",
  "/bin",
  "/bin",
  "--ro-bind-try",
  "/opt/jdk-21",
  "/opt/jdk-21",
  "--proc",
  "/proc",
  "--dev",
  "/dev",
  "--tmpfs",
  "/tmp",
  "--bind",
  "/work/shop/plain_modules/app/code",
  "/work/shop/plain_modules/app/code",
  "--bind",
  "/work/shop/plain_modules/.turri/home/app",
  "/work/shop/plain_modules/.turri/home/app",
  "--bind",
  "/work/shop/plain_modules/.turri/tmp/app",
  "/work/shop/plain_modules/.turri/tmp/app",
  "--bind",
  "/work/shop/plain_modules/.turri/cache",
  "/work/shop/plain_modules/.turri/cache",
  "--chdir",
  "/work/shop/plain_modules/app/code",
]
`;

