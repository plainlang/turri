{
  "name": "turri",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "An agent that builds code from ***plain specifications, with harness-enforced review and conformance gates.",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "turri": "bin/turri.mjs"
  },
  "scripts": {
    "cultivate": "tsx src/cultivate-cli.ts",
    "typecheck": "tsc --noEmit",
    "chat": "pi -e ./src/extension.ts",
    "ask": "pi -p --no-session -e ./src/extension.ts",
    "test": "vitest run",
    "vm:image": "node bin/turri.mjs vm-image",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation.mjs",
    "bind": "tsx src/bind-cli.ts",
    "regrow": "tsx src/regrow-cli.ts",
    "validate": "tsx src/validate-cli.ts",
    "setup": "node bin/turri.mjs setup",
    "doctor": "node bin/turri.mjs doctor",
    "grammar:sync": "node scripts/sync-plyn-grammar.mjs"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@langchain/langgraph": "1.4.15",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.29.0",
    "mdast-util-from-markdown": "^2.0.3",
    "remark-parse": "^11.0.0",
    "typebox": "^1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "assets",
    "bin",
    "src",
    ".pi",
    "genome",
    "stdlib",
    "vm",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
