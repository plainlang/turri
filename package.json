{
  "name": "plainwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that builds code from ***plain specifications, with harness-enforced review and conformance gates.",
  "scripts": {
    "forge": "tsx src/run.ts",
    "typecheck": "tsc --noEmit",
    "chat": "pi -e ./src/extension.ts",
    "ask": "pi -p --no-session -e ./src/extension.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "render": "tsx src/render-frid.ts",
    "conformance": "tsx src/conformance-frid.ts",
    "module": "tsx src/render-module.ts",
    "regenerate": "tsx src/regenerate-frid.ts",
    "check": "tsx src/check-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@langchain/langgraph": "1.4.15",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.29.0",
    "mdast-util-from-markdown": "^2.0.3",
    "remark-parse": "^11.0.0",
    "typebox": "^1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "bin": {
    "plainwright": "src/cli.ts"
  },
  "files": [
    "src",
    ".pi",
    "skills",
    "README.md"
  ]
}
