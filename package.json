{
  "name": "@turri-rs/cli",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainlang/turri.git"
  },
  "homepage": "https://github.com/plainlang/turri#readme",
  "bugs": "https://github.com/plainlang/turri/issues",
  "description": "An agent that builds code from ***plain specifications, with harness-enforced review and conformance gates.",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "turri": "bin/turri.mjs"
  },
  "scripts": {
    "cultivate": "tsx src/cultivate-cli.ts",
    "typecheck": "tsc --noEmit",
    "chat": "pi -e ./src/extension.ts",
    "ask": "pi -p --no-session -e ./src/extension.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation.mjs",
    "bind": "tsx src/bind-cli.ts",
    "regenerate": "tsx src/regenerate-cli.ts",
    "validate": "tsx src/validate-cli.ts",
    "doctor": "node bin/turri.mjs doctor",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "grammar:sync": "node scripts/sync-plyn-grammar.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@langchain/langgraph": "1.4.15",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "liquidjs": "^10.29.0",
    "mdast-util-from-markdown": "^2.0.3",
    "remark-parse": "^11.0.0",
    "typebox": "^1.3.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    ".pi",
    "genome",
    "stdlib",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
